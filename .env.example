OFFICE_365_CLIENT_SECRET=<SECRET_KEY>
OFFICE_365_CLIENT_ID=<CLIENT_ID>

OFFICE_365_SITE_NAME=""
OFFICE_365_DOCUMENT_LIBRARY_NAME=""
OFFICE_365_FOLDER_PATH=""
OFFICE_365_CONVERSATION_FOLDER_PATH="3CX Recordings"
OFFICE_365_TENANT_ID=""
OFFICE_365_SITE_HOSTNAME=""

SHAREPOINT_SITE_ID=<SITE_ID>
SHAREPOINT_DRIVE_ID=<DRIVE_ID>

LLM_SERVICE=<LLM_SERVICE> #Options: openai, gemini
LLM_SERVICE_API_KEY=<LLM_API_KEY>

SUPABASE_URL=<SUPABASE_URL>
SUPABASE_KEY=<SUPABASE_KEY>
SUPABASE_SCHEMA=<SUPABASE_SCHEMA>
SUPABASE_TABLE=<SUPABASE_TABLE>
SUPABASE_AUDIO_TABLE=audio_chunks

# Postgres connection string the container can reach (self-hosted: the db service, user postgres; behind
# Supavisor use session mode, port 5432). With it, the API and the indexer create the search tables,
# indexes and functions on startup. Without it they only check and log what is missing.
SUPABASE_DB_URL=
# DB_AUTO_MIGRATE=true              # false = only check
# DB_GRANT_ROLES=service_role       # roles allowed to use the tables/functions (the backend needs the service_role key)

# Auth & Security
AUTH_REDIRECT_URI=https://<tu-backend>.onrender.com/auth/callback
JWT_SECRET_KEY=<clave_aleatoria_larga>

# CORS y WebSocket — origen(es) exacto(s) del frontend, separados por comas. Obligatorio en producción (no vale "*")
FRONTEND_URL=https://<tu-frontend>.onrender.com

# Session tokens (all optional). JWT_SECRET_KEY must be random and at least 32 characters in production
# ACCESS_TOKEN_MINUTES=60           # lifetime of each token; the UI renews it before it expires
# SESSION_MAX_HOURS=12              # absolute session limit, renewing does not extend it
# MAX_MESSAGE_CHARS=4000            # longest question accepted

# Set to "development" to enable /admin/indexing/* (anything else = production, disabled)
APP_ENV=development

# --- Agent tuning (all optional, defaults shown) ---
# CHAT_MODEL=gpt-4o                 # final answers
# LIGHT_MODEL=gpt-4o-mini           # query rewriting, reranking, call analysis
# RETRIEVAL_K=8                     # chunks given to the LLM
# RETRIEVAL_CANDIDATES=20           # chunks fetched before reranking
# RETRIEVAL_MATCH_THRESHOLD=0.4
# AUDIO_MATCH_THRESHOLD=0.2
# RERANK_ENABLED=true
# HISTORY_MAX_MESSAGES=8
# ASR_MODEL=medium                 # Whisper size for call transcription: tiny, base, small, medium, large, turbo
# XDG_CACHE_HOME=/data/cache        # keeps the downloaded Whisper model across restarts (put it on the volume)
# Scheduled indexing only runs inside this daily window (end <= start crosses midnight). --once/--full ignore it
# INDEXING_WINDOW_START=22:00
# INDEXING_WINDOW_END=05:00
# INDEXING_TZ=America/Santo_Domingo
# INDEXING_PAUSE_SECONDS=1

# Admin panel (/admin in the UI): departments allowed to open it, comma separated (accents/case ignored)
# ADMIN_DEPARTMENTS=Tecnología
# Minutes between automatic "pending files" reports computed by the indexer (lists SharePoint, read-only)
# INGESTION_REPORT_MINUTES=120
# The audio root folder is OFFICE_365_CONVERSATION_FOLDER_PATH (above). Which subfolders (extensions) are
# ingested, and their department, are chosen in the panel and stored in Supabase (migration 0003).          # idle time between files while indexing (raise it if searches time out)

# Call recordings: managers ("GR - ...") plus these departments (comma separated). Unset = managers only.
AUDIO_ALLOWED_DEPARTMENTS=
