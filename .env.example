OFFICE_365_CLIENT_SECRET=<SECRET_KEY>
OFFICE_365_CLIENT_ID=<CLIENT_ID>

OFFICE_365_SITE_NAME=""
OFFICE_365_DOCUMENT_LIBRARY_NAME=""
OFFICE_365_FOLDER_PATH=""
OFFICE_365_CONVERSATION_FOLDER_PATH="3CX Recordings"
OFFICE_365_TENANT_ID=""
OFFICE_365_SITE_HOSTNAME=""

SHAREPOINT_SITE_ID=<SITE_ID>
SHAREPOINT_DRIVE_ID=<DRIVE_ID>

LLM_SERVICE=<LLM_SERVICE> #Options: openai, gemini
LLM_SERVICE_API_KEY=<LLM_API_KEY>
# Embeddings (optional, defaults follow LLM_SERVICE). Changing them means re-indexing every document and
# call; the vector size is fixed in db/db_setup.py (1536 = text-embedding-3-small). OpenRouter can't serve them.
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# OpenRouter (WP4b): off by default. When on, only admin-built tools may use it, never the documents/calls
# agents. Its key is set from /admin/models/providers/openrouter/key and stored encrypted (not here); the
# provider must also be enabled there. Models are discovered from OpenRouter, start disabled, and may read
# at most `internal` data. Monthly budgets per role: permission constraint {"llm_budget_usd_month": N}.
# OPENROUTER_ENABLED=false
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

SUPABASE_URL=<SUPABASE_URL>
SUPABASE_KEY=<SUPABASE_KEY>
SUPABASE_SCHEMA=<SUPABASE_SCHEMA>
SUPABASE_TABLE=<SUPABASE_TABLE>
SUPABASE_AUDIO_TABLE=audio_chunks

# Postgres connection string the container can reach (self-hosted: the db service, user postgres; behind
# Supavisor use session mode, port 5432). With it, the API and the indexer create the search tables,
# indexes and functions on startup. Without it they only check and log what is missing.
SUPABASE_DB_URL=
# DB_AUTO_MIGRATE=true              # false = only check
# DB_GRANT_ROLES=service_role       # roles allowed to use the tables/functions (the backend needs the service_role key)

# Auth & Security
AUTH_REDIRECT_URI=https://<tu-backend>.onrender.com/auth/callback
JWT_SECRET_KEY=<clave_aleatoria_larga>

# CORS y WebSocket — origen(es) exacto(s) del frontend, separados por comas. Obligatorio en producción (no vale "*")
FRONTEND_URL=https://<tu-frontend>.onrender.com

# Session tokens (all optional). JWT_SECRET_KEY must be random and at least 32 characters in production
# ACCESS_TOKEN_MINUTES=60           # lifetime of each token; the UI renews it before it expires
# SESSION_MAX_HOURS=12              # absolute session limit, renewing does not extend it
# MAX_MESSAGE_CHARS=4000            # longest question accepted

# Users are registered on their first Microsoft 365 login (OFFICE_365_TENANT_ID must be the cooperative's
# tenant, not common/organizations). Status of a new user: active (can use the app right away) or pending
# (an admin approves it). Any other value counts as pending.
# USER_DEFAULT_STATUS=active

# Set to "development" to enable /admin/indexing/* (anything else = production, disabled)
APP_ENV=development

# --- Agent tuning (all optional, defaults shown) ---
# CHAT_MODEL=gpt-4o                 # final answers
# LIGHT_MODEL=gpt-4o-mini           # query rewriting, reranking, call analysis
# RETRIEVAL_K=8                     # chunks given to the LLM
# RETRIEVAL_CANDIDATES=20           # chunks fetched before reranking
# RETRIEVAL_MATCH_THRESHOLD=0.4
# AUDIO_MATCH_THRESHOLD=0.2
# RERANK_ENABLED=true
# HISTORY_MAX_MESSAGES=8
# ASR_MODEL=medium                 # Whisper size for call transcription: tiny, base, small, medium, large, turbo
# XDG_CACHE_HOME=/data/cache        # keeps the downloaded Whisper model across restarts (put it on the volume)
# Scheduled indexing only runs inside this daily window (end <= start crosses midnight). --once/--full ignore it
# INDEXING_WINDOW_START=22:00
# INDEXING_WINDOW_END=05:00
# INDEXING_TZ=America/Santo_Domingo
# INDEXING_PAUSE_SECONDS=1

# Access is decided by RBAC (roles and permissions in Supabase, migration 0005), managed from /admin/rbac.
# The first super admin is made from the server shell after their first login:
#   PYTHONPATH=app uv run python -m rbac.cli grant-super-admin persona@cooperativa.com
# RBAC_CACHE_SECONDS=30             # how long permissions are cached; also how long a disabled user keeps working
# RBAC_LEGACY_ENV=true              # false = ignore ADMIN_DEPARTMENTS and AUDIO_ALLOWED_DEPARTMENTS below
# Legacy (one release): departments that also get the admin role, comma separated (accents/case ignored).
# Unset = only the seeded mapping (Tecnología)
# ADMIN_DEPARTMENTS=Tecnología
# Capability registry (tools, MCP servers, CLIs), managed from /admin/capabilities. Connection secrets
# (tokens, passwords) are encrypted with this Fernet key. Generate one with:
#   PYTHONPATH=app uv run python -m capabilities.cli generate-key
# Rotation: CAPABILITY_SECRET_KEY=<new>,<old>, restart, run `python -m capabilities.cli rotate-secrets`,
# then remove the old key. Losing the key means entering every secret again.
CAPABILITY_SECRET_KEY=
# MCP servers (WP5). OAuth "Connect" callback; default: AUTH_REDIRECT_URI's origin + the path below.
# Register this exact URL with providers that need a pre-registered client.
# MCP_OAUTH_REDIRECT_URI=https://<tu-backend>.onrender.com/admin/capabilities/oauth/callback
# Directory of the executables CLI capabilities and stdio MCP servers may run (by name, never a path);
# unset = none run. Files must be executable by CAPABILITY_RUN_AS_USER.
# CAPABILITY_BIN_DIR=/opt/coop-agent/bin
# When the app runs as root (the Docker image does), CLI programs run as this user; without it they
# don't run. The Docker image creates and sets "toolrunner".
# CAPABILITY_RUN_AS_USER=toolrunner
# CAPABILITY_CACHE_SECONDS=30       # how long the registry is cached (admin changes clear it at once)
# CAPABILITY_TIMEOUT_SECONDS=30     # default limit per call (an operation's limits can lower or raise it)
# CAPABILITY_MAX_OUTPUT_CHARS=50000 # longer tool output is cut before it reaches the model
# Minutes between automatic "pending files" reports computed by the indexer (lists SharePoint, read-only)
# INGESTION_REPORT_MINUTES=120
# The audio root folder is OFFICE_365_CONVERSATION_FOLDER_PATH (above). Which subfolders (extensions) are
# ingested, and their department, are chosen in the panel and stored in Supabase (migration 0003).          # idle time between files while indexing (raise it if searches time out)

# Legacy (one release): departments that also get the audio_user role (calls). Unset = managers only, the
# seeded rule. Prefer assigning audio_user or mapping a department to it from /admin/rbac.
AUDIO_ALLOWED_DEPARTMENTS=
