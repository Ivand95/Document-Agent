# ============================================================================
# BACK (API: FastAPI, chat + admin panel). Copy to .env (local) or paste in the deploy's variables.
# Does NOT need SharePoint credentials for documents/audio: the indexer (.env.jobs.example) does that.
# ============================================================================

# --- Supabase ---
SUPABASE_URL=<SUPABASE_URL>
SUPABASE_KEY=<SUPABASE_SERVICE_ROLE_KEY>   # must be the service_role key
SUPABASE_SCHEMA=documents_rag
SUPABASE_TABLE=chunks
SUPABASE_AUDIO_TABLE=audio_chunks

# Postgres connection string the container can reach (self-hosted: the db service, user postgres; behind
# Supavisor use session mode, port 5432). With it, the API creates the search tables, indexes and functions
# on startup (including the admin panel tables). Without it it only checks and logs what is missing.
SUPABASE_DB_URL=
# DB_AUTO_MIGRATE=true              # false = only check
# DB_GRANT_ROLES=service_role       # roles allowed to use the tables/functions

# --- LLM ---
LLM_SERVICE=openai                  # chat answers require openai
LLM_SERVICE_API_KEY=<LLM_API_KEY>

# --- Login with Microsoft ---
OFFICE_365_CLIENT_ID=<CLIENT_ID>
OFFICE_365_CLIENT_SECRET=<SECRET_KEY>
OFFICE_365_TENANT_ID=<TENANT_ID>
AUTH_REDIRECT_URI=https://<tu-backend>/auth/callback

# --- Security ---
JWT_SECRET_KEY=<clave_aleatoria_de_32_caracteres_o_mas>
# Exact origin(s) of the frontend, comma separated. Required in production ("*" is not accepted)
FRONTEND_URL=https://<tu-frontend>
# "development" turns on /admin/indexing/* (it runs indexing inside the API, needs SharePoint variables and
# is meant for local use). Anything else is production.
APP_ENV=production
# ACCESS_TOKEN_MINUTES=60           # lifetime of each token; the UI renews it before it expires
# SESSION_MAX_HOURS=12              # absolute session limit, renewing does not extend it
# MAX_MESSAGE_CHARS=4000            # longest question accepted

# --- Who can do what ---
# Departments that can open the admin panel (/admin), comma separated, accents/case ignored
# ADMIN_DEPARTMENTS=Tecnología
# Call recordings: managers ("GR - ...") plus these departments (comma separated). Unset = managers only
AUDIO_ALLOWED_DEPARTMENTS=

# --- Shown in the admin panel: keep them equal to the jobs deploy ---
# OFFICE_365_CONVERSATION_FOLDER_PATH=3CX Recordings
# INDEXING_WINDOW_START=22:00
# INDEXING_WINDOW_END=05:00
# INDEXING_TZ=America/Santo_Domingo

# --- Agent tuning (all optional, defaults shown) ---
# CHAT_MODEL=gpt-4o                 # final answers
# LIGHT_MODEL=gpt-4o-mini           # query rewriting, reranking
# RETRIEVAL_K=8                     # chunks given to the LLM
# RETRIEVAL_CANDIDATES=20           # chunks fetched before reranking
# RETRIEVAL_MATCH_THRESHOLD=0.4
# AUDIO_MATCH_THRESHOLD=0.2
# RERANK_ENABLED=true
# HISTORY_MAX_MESSAGES=8

# PORT=8000
