# ============================================================================
# JOBS (indexer: jobs/indexing.py). SharePoint -> Supabase, transcribes calls, builds the admin panel report.
# Copy to .env (local) or paste in the deploy's variables. Needs a persistent volume mounted at /data.
# ============================================================================

# --- Supabase ---
SUPABASE_URL=<SUPABASE_URL>
SUPABASE_KEY=<SUPABASE_SERVICE_ROLE_KEY>   # must be the service_role key
SUPABASE_SCHEMA=documents_rag
SUPABASE_TABLE=chunks
SUPABASE_AUDIO_TABLE=audio_chunks

# Postgres connection string the container can reach. With it the indexer creates/updates the tables on startup.
SUPABASE_DB_URL=
# DB_AUTO_MIGRATE=true              # false = only check
# DB_GRANT_ROLES=service_role

# --- LLM (embeddings + call analysis) ---
LLM_SERVICE=openai                  # call analysis requires openai
LLM_SERVICE_API_KEY=<LLM_API_KEY>
# LIGHT_MODEL=gpt-4o-mini           # model that analyses each call

# --- SharePoint (Microsoft Graph) ---
OFFICE_365_TENANT_ID=<TENANT_ID>
OFFICE_365_CLIENT_ID=<CLIENT_ID>
OFFICE_365_CLIENT_SECRET=<SECRET_KEY>
OFFICE_365_SITE_HOSTNAME=<tenant>.sharepoint.com

# Documents (the whole library is indexed)
OFFICE_365_SITE_NAME=<SITE_NAME>
OFFICE_365_DOCUMENT_LIBRARY_NAME=<LIBRARY_NAME>

# Call recordings. The subfolders of the root folder are the extensions; choose which ones are loaded,
# and their department, in the admin panel (stored in Supabase).
OFFICE_365_CONVERSATION_SITE_NAME=<SITE_NAME>
OFFICE_365_CONVERSATION_DOCUMENT_LIBRARY_NAME=<LIBRARY_NAME>
OFFICE_365_CONVERSATION_FOLDER_PATH=3CX Recordings

# --- Where and when it works ---
INDEXING_DATA_DIR=/data             # downloads + sync state survive restarts (mount a volume here)
# XDG_CACHE_HOME=/data/cache        # keeps the downloaded Whisper model across restarts
# Scheduled indexing only runs inside this daily window (end <= start crosses midnight).
# --once / --full and "Cargar ahora" in the panel ignore it.
# INDEXING_WINDOW_START=22:00
# INDEXING_WINDOW_END=05:00
# INDEXING_TZ=America/Santo_Domingo
# INGESTION_REPORT_MINUTES=120      # how often the "pending files" report is refreshed (read-only SharePoint listing)

# --- Speed vs. server load ---
# ASR_MODEL=medium                  # Whisper size: tiny, base, small, medium, large, turbo (smaller = faster, less accurate)
# INDEXING_PAUSE_SECONDS=1          # idle time between files (raise it if searches time out)
